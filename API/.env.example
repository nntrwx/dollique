PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dollique_db
JWT_SECRET=your_jwt_secret_key_here

# Optional: Nodemailer SMTP Configuration
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Moderation: days before a hidden post is auto-deleted, and how often to check (minutes)
MODERATION_GRACE_DAYS=7
MODERATION_CHECK_MINUTES=60

# Auto-ban: number of active strikes that bans a user, and for how many days
BAN_STRIKES=3
BAN_DAYS=7